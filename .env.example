# Site URL for metadata + JSON-LD (production: https://angieskc.com).
NEXT_PUBLIC_SITE_URL=

# Admin photo uploads: https://angieskc.com/admin/photos
ADMIN_PHOTOS_PASSWORD=
# Optional; defaults to deriving from ADMIN_PHOTOS_PASSWORD if unset.
ADMIN_SESSION_SECRET=
# When set to "database", menu/locations/schedule load from Postgres if tables have rows (see admin Menu tab).
SITE_DATA_SOURCE=
# Postgres for admin catalog + photo metadata (Neon, Vercel Postgres, etc.).
DATABASE_URL=
# Public file storage for uploads (Vercel Blob read/write token).
BLOB_READ_WRITE_TOKEN=

# Menu: use Postgres relational catalog (import JSON from /admin → Menu, or `npm run import:menu`).
# Legacy `menu_items` table is still used when relational tables are empty and SITE_DATA_SOURCE=database.
# Google Sheet CSV for menu is no longer read by the app.

# Locations CSV — includes messageBoard column for Today's truck note.
LOCATIONS_CSV_URL=
NEXT_PUBLIC_LOCATIONS_CSV_URL=

# Upcoming schedule CSV.
SCHEDULE_CSV_URL=
NEXT_PUBLIC_SCHEDULE_CSV_URL=

# Browser/public Google Maps key (referrer-restricted). Used for embeds + client geocoding.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional server Geocoding API key (IP-restricted). Not required if client geocode is enough.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_API_KEY=

# Square POS — card payments in the checkout drawer.
# Get these from https://developer.squareup.com/apps
# All four must match the same environment (sandbox OR production — never mix).
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
# Server-side access token for charging cards (keep secret)
SQUARE_ACCESS_TOKEN=

# Order notifications — Telegram Bot for merchant alerts.
# 1. Create bot with @BotFather on Telegram: /newbot
# 2. Get bot token (format: 1234567890:ABC-DEF...)
# 3. Create a Telegram group for order notifications (e.g. "AngiesKC")
# 4. Add the bot to the group
# 5. Send /start in the group
# 6. Run: curl "https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates"
# 7. Find the group chat ID (negative number, e.g. -5059689651)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDERS_CHAT_ID=

# Customer + merchant order emails — Resend (transactional).
# Sign up at https://resend.com (free tier: 3,000 emails/month, 100/day)
# Get API key from dashboard (starts with re_...)
# Optional: Add custom domain (e.g. order@angieskc.com) in Resend dashboard + DNS setup
RESEND_API_KEY=
# Sender — @angieskc.com after domain verified in Resend (optional; orders use Telegram by default)
RESEND_ORDER_FROM=Angie's KC <orders@angieskc.com>
# Kitchen-ticket email via Resend (comma-separated). Telegram still fires too.
# Example: foodtruck83@icloud.com,angiesfoodtruck83@gmail.com
MERCHANT_ORDER_EMAILS=
